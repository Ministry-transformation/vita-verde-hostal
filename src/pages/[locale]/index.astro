---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { copy, bookingUrl, tourismUrl, mapsUrl, realPhotos, roomCategories } from '../../data/site.js';
export function getStaticPaths() { return ['es', 'en'].map((locale) => ({ params: { locale } })); }
const { locale } = Astro.params;
const t = copy[locale];
const title = locale === 'es' ? 'Vita Verde Hostal Boutique en Torrevieja' : 'Vita Verde Boutique Hostal in Torrevieja';
const heroDescription = locale === 'es' ? 'Doce habitaciones en una calle tranquila del centro de Torrevieja, cerca de los servicios de la ciudad.' : 'Twelve rooms on a quiet street in central Torrevieja, close to the city’s everyday services.';
const homeGalleryPhotos = [realPhotos[3], realPhotos[1], realPhotos[2], realPhotos[4], realPhotos[5]];
---
<SiteLayout locale={locale} active={0} title={title} description={heroDescription}>
  <main id="main-content">
    <section class="hero" aria-labelledby="hero-title">
      <div class="wrap hero-layout">
        <div class="hero-content">
          <h1 id="hero-title" class="display" set:html={t.heroTitle} />
          <p class="hero-copy">{heroDescription}</p>
          <div class="hero-buttons">
            <a class="button primary" href={bookingUrl} target="_blank" rel="noreferrer">{t.availability}<span aria-hidden="true">↗</span></a>
            <a class="text-link" href={t.paths[1]}>{t.explore}<span aria-hidden="true">→</span></a>
          </div>
        </div>
        <figure class="hero-photo"><img src={realPhotos[0].src} alt={locale === 'es' ? 'Fachada de Vita Verde Hostal Boutique en Torrevieja' : 'Vita Verde Hostal Boutique facade in Torrevieja'} fetchpriority="high" width="1400" height="933" /><figcaption>{locale === 'es' ? 'Calle San Pascual, 175' : 'Calle San Pascual, 175'}</figcaption></figure>
      </div>
    </section>

    <section class="proofs" aria-label={locale === 'es' ? 'Datos del alojamiento' : 'Property facts'}>
      <div class="wrap proofs-grid">
        <div class="proof">{locale === 'es' ? '12 habitaciones' : '12 guest rooms'}</div>
        <div class="proof">{locale === 'es' ? 'Abierto todo el año' : 'Open year-round'}</div>
        <div class="proof">{locale === 'es' ? 'En el centro de Torrevieja' : 'In central Torrevieja'}</div>
      </div>
      <p class="rating-note">{t.bookingFacts}</p>
    </section>

    <section class="rooms-section" id="rooms" aria-labelledby="rooms-title">
      <div class="wrap">
        <h2 id="rooms-title" class="display section-title">{t.roomsTitle}</h2>
        <p class="section-intro">{t.pages.rooms.text}</p>
        <div class="room-feature">
          <figure class="room-image"><img src={realPhotos[5].src} alt={locale === 'es' ? 'Interior de una habitación de Vita Verde con cama doble y tonos claros' : 'Vita Verde guest room with a double bed and light finishes'} loading="lazy" width="1400" height="933" /><figcaption>{locale === 'es' ? 'Una habitación de Vita Verde' : 'A Vita Verde guest room'}</figcaption></figure>
          <div class="room-categories">
            {roomCategories[locale].map(([name, beds]) => <a class="room-type" href={bookingUrl} target="_blank" rel="noreferrer"><span class="room-type-name">{name}</span><span class="room-type-beds">{beds}</span><span class="room-type-arrow" aria-hidden="true">↗</span></a>)}
          </div>
        </div>
        <p class="small-note">{locale === 'es' ? 'La ficha muestra ocho categorías de habitación. La fotografía no está asignada a una categoría concreta. Consulta disponibilidad y configuración en el anuncio.' : 'The listing shows eight room categories. This photograph is not assigned to a specific category. Check current availability and configuration on the listing.'}</p>
      </div>
    </section>

    <section class="essence" aria-labelledby="essence-title">
      <div class="essence-copy">
        <h2 id="essence-title" class="display section-title" set:html={t.essenceTitle} />
        <p>{t.essenceText}</p>
        <a class="text-link" href={t.paths[2]}>{t.story}<span aria-hidden="true">→</span></a>
      </div>
      <figure class="essence-image"><img src={realPhotos[2].src} alt={locale === 'es' ? 'Patio de Vita Verde con plantas y zona de descanso' : 'Vita Verde patio with plants and a place to sit'} loading="lazy" width="1200" height="900" /><figcaption>{locale === 'es' ? 'El patio de Vita Verde' : 'The Vita Verde patio'}</figcaption></figure>
    </section>

    <section class="comforts" aria-labelledby="comfort-title">
      <div class="wrap">
        <h2 id="comfort-title" class="display section-title">{t.comfortTitle}</h2>
        <ul class="amenity-list">{t.comforts.map((item) => <li>{item}</li>)}</ul>
        <a class="text-link" href={t.paths[2]}>{locale === 'es' ? 'Ver servicios y condiciones' : 'See amenities and stay details'}<span aria-hidden="true">→</span></a>
      </div>
    </section>

    <section class="property-gallery" aria-labelledby="gallery-title">
      <div class="wrap">
        <h2 id="gallery-title" class="display section-title">{locale === 'es' ? 'Vita Verde, en imágenes.' : 'Vita Verde, in pictures.'}</h2>
        <div class="real-gallery">{homeGalleryPhotos.map((photo) => <figure><img src={photo.src} alt={locale === 'es' ? photo.alt : photo.alt.replace('Fachada', 'Exterior').replace('Imagen del alojamiento Vita Verde', 'Vita Verde property').replace('Patio de Vita Verde', 'Vita Verde patio').replace('Exterior de Vita Verde Hostal Boutique', 'Vita Verde Hostal Boutique exterior').replace('Baño en Vita Verde', 'Vita Verde bathroom').replace('Habitación de Vita Verde', 'Vita Verde guest room')} loading="lazy" width="1400" height="933" /><figcaption>{locale === 'es' ? photo.alt : photo.alt.replace('Fachada', 'Exterior').replace('Imagen del alojamiento Vita Verde', 'Vita Verde property').replace('Patio de Vita Verde', 'Vita Verde patio').replace('Exterior de Vita Verde Hostal Boutique', 'Vita Verde Hostal Boutique exterior').replace('Baño en Vita Verde', 'Vita Verde bathroom').replace('Habitación de Vita Verde', 'Vita Verde guest room')}</figcaption></figure>)}</div>
      </div>
    </section>

    <section class="location" aria-labelledby="location-title">
      <div class="wrap location-grid">
        <div><h2 id="location-title" class="display section-title">{t.destinationTitle}</h2><p>{t.pages.location.text}</p><a class="button dark" href={mapsUrl} target="_blank" rel="noreferrer">{locale === 'es' ? 'Ver ruta en el mapa' : 'Get directions'}<span aria-hidden="true">↗</span></a></div>
        <figure class="location-image"><img src="/images/coast-illustrative.jpg" alt={locale === 'es' ? 'Escena de costa ilustrativa generada con IA, no es una fotografía local' : 'AI-generated illustrative coastal scene, not a local photograph'} loading="lazy" width="1536" height="1024" /><figcaption>{t.conceptPhotoNote}</figcaption></figure>
      </div>
    </section>

    <section class="booking-cta" aria-labelledby="booking-title">
      <div class="wrap booking-cta-inner"><h2 id="booking-title" class="display">{locale === 'es' ? 'Consulta fechas y tarifas.' : 'Check dates and rates.'}</h2><p>{locale === 'es' ? 'La disponibilidad y las condiciones se actualizan en el anuncio del alojamiento.' : 'Current availability and booking terms are shown on the property listing.'}</p><a class="button primary" href={bookingUrl} target="_blank" rel="noreferrer">{t.book}<span aria-hidden="true">↗</span></a></div>
    </section>
  </main>
</SiteLayout>
