---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { copy, bookingUrl, tourismUrl, mapsUrl, realPhotos, roomCategories } from '../../data/site.js';
export function getStaticPaths() {
  const pageKeys = ['rooms', 'experience', 'location', 'contact'];
  const slugs = { es: ['habitaciones', 'experiencia', 'ubicacion', 'contacto'], en: ['rooms', 'experience', 'location', 'contact'] };
  return ['es', 'en'].flatMap((locale) => pageKeys.map((key, i) => ({ params: { locale, page: slugs[locale][i] }, props: { key, active: i + 1 } })));
}
const { locale } = Astro.params;
const { key, active } = Astro.props;
const t = copy[locale];
const page = t.pages[key];
const title = `${t.pageNames[key]} | Vita Verde Hostal Boutique, Torrevieja`;
---
<SiteLayout locale={locale} active={active} title={title} description={page.text}>
  <main id="main-content">
    <section class="inner-hero" aria-labelledby="page-title"><div class="wrap"><h1 id="page-title" class="display">{page.title}</h1><p class="inner-hero-copy">{page.text}</p></div></section>
    <section class="inner-body"><div class="wrap">
      {key === 'rooms' && <>
        <div class="room-categories inner-room-categories">{roomCategories[locale].map(([name, beds]) => <a class="room-type" href={bookingUrl} target="_blank" rel="noreferrer"><span class="room-type-name">{name}</span><span class="room-type-beds">{beds}</span><span class="room-type-arrow" aria-hidden="true">↗</span></a>)}</div>
        <p class="small-note">{locale === 'es' ? 'La ficha muestra ocho categorías, no ocho unidades disponibles. Comprueba la configuración actual en el anuncio.' : 'The listing shows eight categories, not eight available units. Confirm the current configuration on the listing.'}</p>
        <h2 class="display room-gallery-title">{locale === 'es' ? 'Fotos del alojamiento' : 'Property photographs'}</h2>
        <div class="real-gallery">{realPhotos.map((photo) => <figure><img src={photo.src} alt={photo.alt} loading="lazy" width="1400" height="933" /><figcaption>{photo.alt}</figcaption></figure>)}</div>
      </>}

      {key === 'experience' && <>
        <div class="comfort-grid"><div><h2 class="display section-title">{t.comfortTitle}</h2><p class="section-intro">{locale === 'es' ? 'Comodidades publicadas para preparar una estancia cómoda. Confirma los servicios concretos al reservar.' : 'Published amenities to help plan a comfortable stay. Confirm specific services when booking.'}</p></div><ul class="amenity-list">{t.comforts.map((item) => <li>{item}</li>)}</ul></div>
        <div class="policy-list"><h2 class="display">{locale === 'es' ? 'Antes de llegar.' : 'Before you arrive.'}</h2>{t.policies.map(([label, value]) => <div><strong>{label}</strong><p>{value}</p></div>)}</div>
      </>}

      {key === 'location' && <div class="location-detail">
        <div class="info-inner"><div><h2>{locale === 'es' ? 'La dirección' : 'The address'}</h2><p>Calle San Pascual, 175<br />03181 Torrevieja, Alicante, {locale === 'es' ? 'España' : 'Spain'}</p></div><div><p>{locale === 'es' ? 'En una calle tranquila del centro, con servicios urbanos y la costa cerca.' : 'On a quieter street in the centre, close to city services and the coast.'}</p><div class="info-links"><a class="button dark" href={mapsUrl} target="_blank" rel="noreferrer">{locale === 'es' ? 'Abrir indicaciones' : 'Open directions'}<span aria-hidden="true">↗</span></a><a class="text-link" href={tourismUrl} target="_blank" rel="noreferrer">{t.source}<span aria-hidden="true">↗</span></a></div><div class="nearby-list"><p><strong>{locale === 'es' ? 'Playa del Acequión' : 'Acequión Beach'}</strong><span>{locale === 'es' ? 'Menos de 1 km' : 'Under 1 km'}</span></p><p><strong>{locale === 'es' ? 'Aeropuerto de Alicante-Elche' : 'Alicante-Elche Airport'}</strong><span>{locale === 'es' ? 'A unos 41 km' : 'About 41 km'}</span></p></div></div></div>
        <figure class="location-image standalone-location-image"><img src={realPhotos[3].src} alt={locale === 'es' ? 'Exterior de Vita Verde Hostal Boutique' : 'Vita Verde Hostal Boutique exterior'} loading="lazy" width="1400" height="933" /><figcaption>{locale === 'es' ? 'Calle San Pascual, 175' : 'Calle San Pascual, 175'}</figcaption></figure>
      </div>}

      {key === 'contact' && <>
        <div class="info-inner contact-grid"><div><h2>{locale === 'es' ? 'Contacta con Vita Verde' : 'Contact Vita Verde'}</h2></div><div class="contact-card"><a class="contact-value" href="tel:+34611978571">+34 611 978 571</a><a class="contact-value" href="mailto:vitaverde.torrevieja@gmail.com">vitaverde.torrevieja@gmail.com</a><p>{t.contact.hours}</p><p>{t.contact.languages}</p><p><strong>{locale === 'es' ? 'Registro turístico' : 'Tourist registration'}:</strong> CV H01750 A</p><div class="info-links"><a class="button primary" href={bookingUrl} target="_blank" rel="noreferrer">{t.availability}<span aria-hidden="true">↗</span></a><a class="button dark" href={mapsUrl} target="_blank" rel="noreferrer">{locale === 'es' ? 'Ver ubicación' : 'View location'}<span aria-hidden="true">↗</span></a></div></div></div>
        <div class="policy-list"><h2 class="display">{locale === 'es' ? 'Condiciones de estancia.' : 'Stay policies.'}</h2>{t.policies.map(([label, value]) => <div><strong>{label}</strong><p>{value}</p></div>)}</div>
      </>}
    </div></section>
    {key !== 'contact' && <section class="inner-booking"><div class="wrap"><h2 class="display">{locale === 'es' ? 'Consulta disponibilidad.' : 'Check availability.'}</h2><a class="button primary" href={bookingUrl} target="_blank" rel="noreferrer">{t.book}<span aria-hidden="true">↗</span></a></div></section>}
  </main>
</SiteLayout>
